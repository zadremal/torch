{
  "name": "torch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["web"],
  "bin": {
    "torch": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test",
    "e2e": "bun test/e2e/run.ts",
    "dev": "bun run dev:server & bun run dev:web; wait",
    "dev:server": "bun --watch src/cli.ts start --no-open",
    "dev:web": "bun run --cwd web dev",
    "dev:seed": "bun test/support/dev-api.ts",
    "build": "bun run --cwd web build",
    "fixtures": "bun test/support/build-dto.ts"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
